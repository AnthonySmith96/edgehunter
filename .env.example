# Pega tu llave de TypeSafe aqui. No compartas este archivo.
TYPESAFE_API_KEY=

# Version del modelo JEV (ej. jev-latest, jev-preview o jev-1.13.0)
TYPESAFE_MODEL=jev-latest

# Tope total autorizado en USD reales para JEV. Cero evita llamadas pagadas por defecto.
# Cambialo de forma explicita solo cuando quieras autorizar gasto.
TYPESAFE_BUDGET_USD=0

# Reserva maxima por llamada en USD. No es precio facturado confirmado.
TYPESAFE_MAX_CALL_USD=0.001

# Tiempo maximo de respuesta de JEV; una respuesta tardia se descarta.
TYPESAFE_TIMEOUT_SECONDS=4
