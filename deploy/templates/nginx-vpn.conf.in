# Include inside http {}; bind ONLY to the inspected management/VPN address.
# No WireGuard peer, route or firewall is created by this template.
limit_req_zone $binary_remote_addr zone=edgehunter_vpn_api:10m rate=20r/s;
log_format edgehunter_private '$remote_addr $request_method $uri $status';
server {
    listen @ADMIN_BIND@:443 ssl;
    server_name @HOST@;
    ssl_certificate /etc/letsencrypt/live/@HOST@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@HOST@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/edgehunter.access.log edgehunter_private;
    client_max_body_size 2m;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    location /api/realtime {
        proxy_pass http://127.0.0.1:@PB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location /api/ {
        limit_req zone=edgehunter_vpn_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:@PB_PORT@;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_cache off;
    }
    location /_/ {
        proxy_pass http://127.0.0.1:@PB_PORT@;
        proxy_set_header Host $host;
        proxy_cache off;
    }
    location = / { return 302 /_/; }
    location / { return 404; }
}
