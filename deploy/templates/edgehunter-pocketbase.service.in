[Unit]
Description=EdgeHunter dedicated PocketBase control
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=edgehunter-pb
Group=edgehunter-pb
WorkingDirectory=@RELEASE_ROOT@
EnvironmentFile=/etc/edgehunter/pocketbase.env
ExecStart=@PB_BINARY@ serve --http=127.0.0.1:@PB_PORT@ --dir=/var/lib/edgehunter-pb/pb_data --migrationsDir=@RELEASE_ROOT@/pocketbase/pb_migrations --hooksDir=@RELEASE_ROOT@/pocketbase/pb_hooks --automigrate=false
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
StateDirectory=edgehunter-pb
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/edgehunter-pb
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
CPUQuota=50%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
