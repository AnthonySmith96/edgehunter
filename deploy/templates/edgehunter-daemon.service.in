[Unit]
Description=EdgeHunter SHADOW research daemon - no live trading
After=network-online.target edgehunter-pocketbase.service
Wants=network-online.target edgehunter-pocketbase.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=edgehunter
Group=edgehunter
WorkingDirectory=@RELEASE_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@RELEASE_ROOT@/.venv/bin/edgehunter --root @RELEASE_ROOT@ run --mode shadow --state-dir /var/lib/edgehunter --pocketbase-url http://127.0.0.1:@PB_PORT@ --daemon-credentials /etc/edgehunter/daemon.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
StateDirectory=edgehunter
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/edgehunter
InaccessiblePaths=/var/lib/edgehunter-pb
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=50%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
